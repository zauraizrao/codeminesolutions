RewriteEngine On
Options -MultiViews

# Canonical clean routes. Keep legacy indexed URLs working with permanent redirects.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

RewriteRule ^work\.html$ /portfolio/ [R=301,L]
RewriteRule ^work/?$ /portfolio/ [R=301,L]
RewriteRule ^blog\.html$ /blog/ [R=301,L]
RewriteRule ^sitemap\.html$ /sitemap/ [R=301,L]

RewriteCond %{QUERY_STRING} ^slug=web-development$ [NC]
RewriteRule ^service(?:\.html)?$ /services/web-development/ [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=digital-marketing$ [NC]
RewriteRule ^service(?:\.html)?$ /services/digital-marketing/ [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=seo$ [NC]
RewriteRule ^service(?:\.html)?$ /services/seo/ [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=e-books$ [NC]
RewriteRule ^service(?:\.html)?$ /services/e-books/ [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=truck-dispatching$ [NC]
RewriteRule ^service(?:\.html)?$ /services/truck-dispatching/ [R=301,L]

RewriteRule ^trucking\.html$ /services/truck-dispatching/ [R=301,L]
RewriteRule ^trucking/?$ /services/truck-dispatching/ [R=301,L]

RewriteCond %{QUERY_STRING} ^slug=([^&]+)$ [NC]
RewriteRule ^project(?:\.html)?$ /portfolio/%1/ [R=301,L,NE]

RewriteRule ^service\.html$ /services/ [R=301,L]
RewriteRule ^project\.html$ /portfolio/ [R=301,L]
RewriteRule ^service/?$ /services/ [R=301,L]
RewriteRule ^project/?$ /portfolio/ [R=301,L]

# Let folder index.html files serve clean URLs.
DirectoryIndex index.html

# Serve the branded not-found page for missing routes and assets.
ErrorDocument 404 /404.html

# Compress text payloads when the hosting stack supports it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

# Revalidate documents, but cache versioned code and media for repeat visits.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.(?:mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
